#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# .github/workflows/gates.yml runs these same gates in CI, on every push and
# pull request. This hook runs them again locally, before anything leaves the
# machine (pre-push), so a broken gate is caught before it even reaches GitHub.
# A gate nothing calls is a comment with an exit code.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-44s' "$name"
  if out=$(eval "$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    printf '%s\n' "$out" | sed 's/^/      /'
    fail=$((fail + 1))
  fi
}

echo "pre-push gate"
step "templates load with their consumer's parser" "./scripts/templates-load.sh"
step "no executable ships" "./scripts/no-executables.sh"
step "the gates above can still fail" "./scripts/gates-have-teeth.sh"

echo
if [ "$fail" -ne 0 ]; then
  echo "pre-push: $fail of $((pass + fail)) checks failed. Nothing pushed."
  exit 1
fi
echo "pre-push: all $pass checks passed."
